# Frontend environment variables
# Note: Never expose API keys or model IDs in browser NEXT_PUBLIC_ variables

# Backend internal URL for same-origin proxy route (/api/[...path])
BACKEND_URL=http://localhost:8000

# Public URL prefix required to reach the app. Set the same value as the backend.
APP_SECRET_PATH=secret-path
NEXT_PUBLIC_APP_SECRET_PATH=secret-path

# Backend path prefix used by the server-side proxy.
BACKEND_APP_SECRET_PATH=secret-path
