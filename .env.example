# ==============================================================================
# Sovereign AI Control Plane - Environment Configuration Template
# Suitable for Local Docker Compose & Production Deployment on Liara (liara.ir)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=litellm
POSTGRES_PASSWORD=litellm_secure_password
POSTGRES_DB=litellm
# For local docker: postgres:5432 / For Liara managed DB: use provided connection string
DATABASE_URL=postgresql://litellm:litellm_secure_password@postgres:5432/litellm

# ------------------------------------------------------------------------------
# 2. Redis Cache Configuration
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# 3. Langfuse Observability & Tracing (Production & Cloud Ready)
# ------------------------------------------------------------------------------
# Keys obtained from Langfuse UI (Settings -> API Keys)
LANGFUSE_PUBLIC_KEY=pk-lf-8054958d-e8f3-4661-912c-69a351a5156d
LANGFUSE_SECRET_KEY=sk-lf-468e625d-5c34-45c6-aca2-a0b24877b3f2

# Host endpoint:
# - Local Docker: http://langfuse:3000
# - Local Browser: http://localhost:3000
# - Liara Cloud Deployment: https://<your-langfuse-app-name>.iran.liara.run
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_RELEASE=v2.0.0-production
LANGFUSE_ENABLED=true

# ------------------------------------------------------------------------------
# 4. LiteLLM Proxy & Master Keys
# ------------------------------------------------------------------------------
LITELLM_MASTER_KEY=sk-lite-master-1234
LITELLM_URL=http://litellm:4000
LITELLM_PORT=4000

# ------------------------------------------------------------------------------
# 5. Gateway, Semantic Router & Registry
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
REGISTRY_PORT=8200
SEMANTIC_PORT=8300
FRONTEND_PORT=8400

# ------------------------------------------------------------------------------
# 6. RAG & Vector Engine Configuration
# ------------------------------------------------------------------------------
RAG_VECTOR_STORE_BACKEND=memory
RAG_WEAVIATE_URL=http://weaviate:8080
RAG_EMBEDDING_MODEL_PATH=/models/bge-m3